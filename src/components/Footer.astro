---
import { siteConfig, features } from '@site';
import { href } from '../lib/url';
import { socialLinks, hasCV, placeReadout } from '../lib/site';
import { getProjects, getNotes } from '../lib/content';
import Icon from './Icon.astro';

const projects = await getProjects();
const notes = await getNotes();
const year = new Date().getFullYear();
const index = [
  { label: 'Home', href: '/' },
  ...(projects.length ? [{ label: 'Work', href: '/work/' }] : []),
  { label: 'About', href: '/about/' },
  ...(features.notes && notes.length ? [{ label: 'Notes', href: '/notes/' }] : []),
];
const github = siteConfig.social.github;
// GitHub already sits in the contact block above; the list holds everything else
const elsewhere = socialLinks.filter((s) => s.id !== 'github');
const action = siteConfig.contactForm.action;
---

<footer class="footer" data-footer>
  <div class="container">
    <section class="contact" id="contact" aria-labelledby="contact-title" data-reveal>
      <h2 class="contact__title" id="contact-title">Contact</h2>
      <p class="contact__mail"><a class="link" href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a></p>
      {github && (
        <p class="contact__more">
          <a class="link action" href={github} rel="noopener me"><Icon name="github" />GitHub<Icon name="arrow_outward" /></a>
        </p>
      )}
      {features.contactForm && (
        <form class="form" method="post" action={action || undefined} data-contact-form data-mailto={siteConfig.email}>
          <label><span class="label">Name</span><input name="name" autocomplete="name" required /></label>
          <label><span class="label">Email</span><input name="email" type="email" autocomplete="email" required /></label>
          <label><span class="label">Message</span><textarea name="message" required></textarea></label>
          <div><button class="link action" type="submit">Send<Icon name="arrow_forward" /></button></div>
        </form>
      )}
    </section>

    <div class="grid footer__grid">
      <nav class="footer__col" aria-label="Site">
        <p class="label footer__title">Index</p>
        <ul class="footer__list">
          {index.map((i) => <li><a class="link" href={href(i.href)}>{i.label}</a></li>)}
        </ul>
      </nav>

      {projects.length > 0 && (
        <nav class="footer__col footer__col--wide" aria-label="Projects">
          <p class="label footer__title">Projects</p>
          <ul class="footer__list">
            {projects.map((p) => <li><a class="link" href={href(`/work/${p.id}/`)}>{p.data.title}</a></li>)}
          </ul>
        </nav>
      )}

      {(elsewhere.length > 0 || hasCV) && (
        <div class="footer__col">
          <p class="label footer__title">Elsewhere</p>
          <ul class="footer__list">
            {elsewhere.map((s) => (
              <li><a class="link" href={s.url} rel="noopener me">{s.label}<Icon name="arrow_outward" /></a></li>
            ))}
            {hasCV && <li><a class="link" href={href(siteConfig.files.cv)} download>CV (PDF)<Icon name="download" /></a></li>}
          </ul>
        </div>
      )}
    </div>

    <p class="footer__mono" aria-hidden="true">{siteConfig.initials}</p>

    <div class="footer__base">
      <p class="label">
        <span>© {year} {siteConfig.name}</span>
        {siteConfig.place && <span>{siteConfig.place.label} <span data-clock data-tz={siteConfig.place.timeZone}></span></span>}
        {placeReadout && <span>{placeReadout}</span>}
      </p>
      <p class="label"><a class="link" href="#top">Back to top</a></p>
    </div>
    <p class="label footer__colophon">Set in Instrument Sans, IBM Plex Mono and Doto. Built with Astro. No cookies, no tracking.</p>
  </div>
</footer>
