---
import { siteConfig, features } from '@site';
import { href, isActive } from '../lib/url';
import { getNotes, getProjects } from '../lib/content';
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';

const pathname = Astro.url.pathname;
const contactDescription = 'Email and GitHub';
const notes = await getNotes();
const projects = await getProjects();
const items = siteConfig.nav.filter((i) => {
  if (i.href === '/work/' && projects.length === 0) return false;
  if (!i.feature) return true;
  if (!features[i.feature]) return false;
  if (i.feature === 'notes') return notes.length > 0;
  return true;
});
---

<header class="nav nav--top" data-nav>
  <div class="container nav__bar">
    <a class="nav__brand" href={href('/')}>
      <span class="nav__mark">{siteConfig.initials}</span><span class="sr-only"> {siteConfig.name}, home</span>
      <span class="nav__brand-name" aria-hidden="true">{siteConfig.name}</span>
    </a>

    <nav class="nav__links" aria-label="Primary">
      {items.map((i) => (
        <a class="link nav__link" href={href(i.href)} aria-current={isActive(pathname, i.href) ? 'page' : undefined}>
          {i.label}
        </a>
      ))}
      <a class="link nav__link" href="#contact">Contact</a>
    </nav>

    <div class="nav__actions">
      <ThemeToggle />
      <button class="nav__menu-btn" type="button" aria-expanded="false" aria-controls="menu" data-menu-btn>
        <span data-menu-label>Menu</span>
        <Icon name="menu" class="icon-open" />
        <Icon name="close" class="icon-close" />
      </button>
    </div>
  </div>
</header>

<div class="menu" id="menu" data-menu>
  <div class="menu__field" data-spec-slot data-menu-field data-scene="dust" data-mode="ambient" data-anchor-y="-0.42" data-opacity="0.5" data-enter="flow" aria-hidden="true"></div>
  <nav class="menu__nav" aria-label="Mobile">
    <ul class="menu__list">
      {items.map((i) => (
        <li class="menu__item">
          <a class="menu__link" href={href(i.href)} aria-current={isActive(pathname, i.href) ? 'page' : undefined}>
            <span class="menu__label">{i.label}</span>
            {i.description && <span class="menu__desc">{i.description}</span>}
          </a>
        </li>
      ))}
      <li class="menu__item">
        <a class="menu__link" href="#contact"><span class="menu__label">Contact</span><span class="menu__desc">{contactDescription}</span></a>
      </li>
    </ul>
  </nav>
  <div class="menu__foot">
    <a class="label link" href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
  </div>
</div>
