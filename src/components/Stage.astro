---
/**
 * The interactive particle stage. The static SVG is server-rendered, so the page is complete
 * before any JS runs; the canvas is brought in lazily.
 *   mode "hero"      fills its (positioned) parent, e.g. the hero section
 *   mode "card"      a project card visual
 *   mode "viewport"  the large framed visual on a project page
 */
import StaticField from './StaticField.astro';
import type { SceneName } from '../scripts/stage/scenes';

interface Props {
  mode?: 'hero' | 'card' | 'viewport';
  scene?: SceneName;
  class?: string;
}
const { mode = 'card', scene = 'scene', class: className = '' } = Astro.props;
const count = mode === 'hero' ? 1500 : mode === 'viewport' ? 1100 : 800;
---

<div class={`stage stage--${mode} ${className}`.trim()} data-stage={mode} data-scene={scene} aria-hidden="true">
  <StaticField scene={scene} class="stage__static" count={count} />
</div>
