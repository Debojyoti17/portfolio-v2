---
import { href } from '../lib/url';
import { projectLine, type Project } from '../lib/content';
import ProjectLine from './ProjectLine.astro';

interface Props {
  project: Project;
  index: number;
}
const { project, index } = Astro.props;
const idx = String(index + 1).padStart(2, '0');
---

<li class="row" data-reveal="wipe">
  <a class="row__link" href={href(`/work/${project.id}/`)}>
    <span class="row__idx dot" aria-hidden="true">{idx}</span>
    <h3 class="row__title">{project.data.title}</h3>
    <p class="row__sum">{project.data.summary}</p>
    <span class="row__status"><ProjectLine line={projectLine(project)} /></span>
  </a>
</li>
