---
import { href } from '../lib/url';
import { projectForm, type Project } from '../lib/content';
import Icon from './Icon.astro';
import StatusTag from './StatusTag.astro';

interface Props {
  project: Project;
  index: number;
}
const { project, index } = Astro.props;
const idx = String(index + 1).padStart(2, '0');
---

<li class="row" data-reveal="wipe">
  <a class="row__link" href={href(`/work/${project.id}/`)} data-hover-form={projectForm(project)}>
    <span class="row__idx dot" aria-hidden="true">{idx}</span>
    <h3 class="row__title">{project.data.title}</h3>
    <p class="row__sum">{project.data.summary}</p>
    <span class="row__status"><StatusTag status={project.data.status} /></span>
  </a>
</li>
