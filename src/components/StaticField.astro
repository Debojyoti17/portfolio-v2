---
/**
 * Static SVG render of a scene: the no-JS / reduced-motion / no-WebGL stand-in for the live stage.
 */
import { buildStaticField } from '../lib/staticField';
import type { SceneName } from '../scripts/stage/scenes';

interface Props {
  scene: SceneName;
  count?: number;
  class?: string;
  /** stills: red only where it carries meaning */
  semanticRedOnly?: boolean;
}
const { scene, count = 1100, class: className = '', semanticRedOnly = false } = Astro.props;
const f = buildStaticField(scene, count, semanticRedOnly);
---

<svg class={`static-field ${className}`.trim()} viewBox={f.viewBox} preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
  <path d={f.far} class="sf-far" />
  <path d={f.near} class="sf-near" />
  <path d={f.accent} class="sf-accent" />
</svg>
