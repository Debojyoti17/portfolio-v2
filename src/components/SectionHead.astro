---
interface Props {
  label: string;
  title: string;
  id?: string;
  aside?: string;
}
const { label, title, id, aside } = Astro.props;
---

<header class="sec-head" data-reveal>
  <p class="sec-head__label label">{label}</p>
  <h2 class="sec-head__title" id={id}>{title}</h2>
  {aside && <p class="sec-head__aside">{aside}</p>}
</header>
