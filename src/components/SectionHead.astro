---
interface Props {
  label: string;
  title: string;
  id?: string;
  aside?: string;
  /** Skip numbering (e.g. for page-level headers). */
  split?: boolean;
  /** Small title (used where the section's content is the headline). */
  compact?: boolean;
}
const { label, title, id, aside, split = true, compact = false } = Astro.props;
---

<header class={`sec-head${compact ? ' sec-head--compact' : ''}`} data-reveal="rule">
  <p class="sec-head__meta"><span class="sec-head__idx" aria-hidden="true"></span><span class="label">{label}</span></p>
  <h2 class="sec-head__title" id={id} data-split={split ? '' : undefined}>{title}</h2>
  {aside && <p class="sec-head__aside">{aside}</p>}
</header>
