---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import { siteConfig } from '@site';
import { href } from '../../lib/url';
import { projectVisual, projectLine, type Project } from '../../lib/content';
import Base from '../../layouts/Base.astro';
import Field from '../Field.astro';
import ProjectLinks from '../ProjectLinks.astro';
import ProjectLine from '../ProjectLine.astro';
import Icon from '../Icon.astro';
import StaticField from '../StaticField.astro';

interface Props {
  project: Project;
  projects: Project[];
  index: number;
}
const { project, projects, index } = Astro.props;
const { Content } = await render(project);
const d = project.data;
const visual = projectVisual(project);
const next = projects[(index + 1) % projects.length];
const facts = d.facts ?? [];
---

<Base title={d.title} description={d.summary} ogImage={`/og/work-${project.id}.png`} ogType="article">
  <article class="project">
    <header class="container page-head project__head">
      <p class="label page-head__label rise-in">
        <a class="link" href={href('/work/')}><Icon name="arrow_back" />Work</a>
        {d.area && <><span aria-hidden="true">/</span><span>{d.area}</span></>}
      </p>
      <h1 class="project__title rise-in" style="--i:1">{d.title}</h1>
      <div class="project__lede rise-in" style="--i:2">
        <p class="lead">{d.summary}</p>
        <p><ProjectLine line={projectLine(project)} /></p>
      </div>
    </header>

    <div class="container rise-in" style="--i:3">
      <Field scene={visual} mode="viewport" name={d.title} />
    </div>

    <div class="container project__body">
      <div class="grid project__grid">
        <aside class="project__facts" aria-label="Project facts" data-reveal>
          <dl class="facts">
            <div><dt class="label">Type</dt><dd>{d.type}</dd></div>
            {d.stage && <div><dt class="label">Stage</dt><dd>{d.stage}</dd></div>}
            {d.role && <div><dt class="label">Role</dt><dd>{d.role}</dd></div>}
            {facts.map((f) => <div><dt class="label">{f.label}</dt><dd>{f.value}</dd></div>)}
            {d.tags.length > 0 && <div><dt class="label">Topics</dt><dd>{d.tags.join(' · ')}</dd></div>}
          </dl>
          <ProjectLinks project={project} class="project__links" />
        </aside>

        <div class="project__main" data-reveal>
          {d.cover && (
            <figure class="project__cover">
              <Image src={d.cover} alt={d.coverAlt ?? ''} widths={[640, 1000, 1400]} sizes="(min-width: 900px) 60vw, 100vw" />
            </figure>
          )}
          <div class="prose project__prose"><Content /></div>
        </div>
      </div>
    </div>

    {projects.length > 1 && (
      <nav class="container project__next" aria-label="Next project" data-reveal>
        <a class="next" href={href(`/work/${next.id}/`)} rel="next" data-project={next.id} data-cursor="View">
          <span class="next__text">
            <span class="label next__label">Next project<Icon name="arrow_forward" /></span>
            <span class="next__title"><span class="next__title-text">{next.data.title}</span></span>
            <span class="meta next__line">{projectLine(next)}</span>
          </span>
          <span class="next__spec" data-spec-slot data-scene={projectVisual(next)} data-mode="spec" aria-hidden="true">
            <StaticField scene={projectVisual(next)} count={600} class="spec__static" semanticRedOnly />
          </span>
        </a>
      </nav>
    )}
  </article>
</Base>
