---
import { features, siteConfig } from '@site';
import { countBy, type Project } from '../../lib/content';
import ProjectCard from '../ProjectCard.astro';

interface Props {
  projects: Project[];
}
const { projects } = Astro.props;

// Grouped by research area (default). A project appears once, under its own area.
const areas = siteConfig.interests
  .map((i) => ({ title: i.title, note: i.note, projects: projects.filter((p) => p.data.area === i.title) }))
  .filter((a) => a.projects.length > 0);
const known = new Set(siteConfig.interests.map((i) => i.title));
const rest = projects.filter((p) => !p.data.area || !known.has(p.data.area));
const groups = [...areas, ...(rest.length ? [{ title: 'More work', note: '', projects: rest }] : [])];

// Optional filter module (features.workFilters)
const tags = countBy(projects, (p) => p.data.tags);
const types = countBy(projects, (p) => [p.data.type]);
const stages = countBy(projects, (p) => (p.data.stage ? [p.data.stage] : []));
const pad = (n: number) => String(n).padStart(2, '0');
---

<header class="container page-head">
  <p class="label page-head__label appear">Work</p>
  <h1 class="page-head__title"><span class="rise"><span>Work</span></span></h1>
  <p class="lead page-head__lead appear">Research and projects, grouped by the area they belong to.</p>
</header>

<section class="container work-index" aria-label="Projects">
  {features.workFilters ? (
    <>
      <div class="filters" data-filters>
        <div class="filters__bar">
          {[
            ['tag', 'Topic', tags],
            ['type', 'Type', types],
            ['stage', 'Stage', stages],
          ].map(([kind, label, list]: any) =>
            list.length > 1 ? (
              <div class="filters__group" role="group" aria-label={label}>
                <p class="label">{label}</p>
                <div class="chips">
                  <button type="button" class="chip" aria-pressed="true" data-filter={kind} data-value="">All<span>{projects.length}</span></button>
                  {list.map(([t, n]: [string, number]) => (
                    <button type="button" class="chip" aria-pressed="false" data-filter={kind} data-value={t}>{t}<span>{n}</span></button>
                  ))}
                </div>
              </div>
            ) : null,
          )}
        </div>
        <p class="label filters__count" role="status" aria-live="polite" data-filter-count>{projects.length} {projects.length === 1 ? 'project' : 'projects'}</p>
      </div>
      <div class="wg__cards wg__cards--flat" data-plates>
        {projects.map((p) => <ProjectCard project={p} />)}
      </div>
    </>
  ) : (
    groups.map((g, gi) => (
      <section class="wg" aria-labelledby={`wg-${gi}`}>
        <header class="wg__head">
          <p class="wg__idx dot" aria-hidden="true">{pad(gi + 1)}</p>
          <h2 class="wg__title" id={`wg-${gi}`}>{g.title}</h2>
          {g.note && <p class="wg__note">{g.note}</p>}
        </header>
        <div class="wg__cards">
          {g.projects.map((p) => <ProjectCard project={p} />)}
        </div>
      </section>
    ))
  )}
</section>
