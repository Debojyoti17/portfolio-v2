---
import { features } from '@site';
import { countBy, type Project } from '../../lib/content';
import ResearchIndex from '../ResearchIndex.astro';
import ProjectEntry from '../ProjectEntry.astro';

interface Props {
  projects: Project[];
}
const { projects } = Astro.props;

// Optional filter module (features.workFilters): one filterable list instead of the grouped index.
const tags = countBy(projects, (p) => p.data.tags);
const types = countBy(projects, (p) => [p.data.type]);
const stages = countBy(projects, (p) => (p.data.stage ? [p.data.stage] : []));
---

<header class="container page-head">
  <p class="label page-head__label rise-in">Work</p>
  <h1 class="page-head__title page-head__title--md rise-in" style="--i:1">Research &amp; projects</h1>
  <p class="lead page-head__lead rise-in" style="--i:2">Grouped by research area. Open a project to work with its field.</p>
</header>

<section class="container work-index" aria-label="Projects">
  {features.workFilters ? (
    <>
      <div class="filters" data-filters>
        <div class="filters__bar">
          {[
            ['tag', 'Topic', tags],
            ['type', 'Type', types],
            ['stage', 'Stage', stages],
          ].map(([kind, label, list]: any) =>
            list.length > 1 ? (
              <div class="filters__group" role="group" aria-label={label}>
                <p class="label">{label}</p>
                <div class="chips">
                  <button type="button" class="chip" aria-pressed="true" data-filter={kind} data-value="">All</button>
                  {list.map(([t]: [string, number]) => (
                    <button type="button" class="chip" aria-pressed="false" data-filter={kind} data-value={t}>{t}</button>
                  ))}
                </div>
              </div>
            ) : null,
          )}
        </div>
        <p class="label filters__count" role="status" aria-live="polite" data-filter-count>{projects.length} {projects.length === 1 ? 'project' : 'projects'}</p>
      </div>
      <div class="rgroup__list" data-plates>
        {projects.map((p) => <ProjectEntry project={p} detailed level={3} />)}
      </div>
    </>
  ) : (
    <ResearchIndex projects={projects} detailed level={2} />
  )}
</section>
