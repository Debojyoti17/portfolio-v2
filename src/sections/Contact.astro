---
import { siteConfig, features } from '@site';
import { href } from '../lib/url';
import { socialLinks, hasCV } from '../lib/site';
import SectionHead from '../components/SectionHead.astro';
import Icon from '../components/Icon.astro';
const action = siteConfig.contactForm.action;
---

<section class="sec" id="contact" aria-labelledby="contact-title" data-section data-numbered data-label="Contact">
  <div class="container">
    <SectionHead label="Contact" title="Get in touch" id="contact-title" />
    <p>
      <a class="contact__mail" href={`mailto:${siteConfig.email}`} data-reveal="fade">{siteConfig.email}<Icon name="arrow_outward" /></a>
    </p>

    <div class="grid contact__grid">
      <div class="contact__block">
        <p class="label">Email</p>
        <div class="btn-row">
          <button class="btn" type="button" data-copy={siteConfig.email}>
            <span data-copy-label>Copy address</span><Icon name="content_copy" />
          </button>
        </div>
        <p class="sr-only" role="status" aria-live="polite" data-copy-status></p>
      </div>

      {(socialLinks.length > 0 || hasCV) && (
        <div class="contact__block">
          <p class="label">Elsewhere</p>
          <ul class="contact__links">
            {socialLinks.map((s) => (
              <li><a class="link" href={s.url} rel="noopener me">{s.label}<Icon name="arrow_outward" /></a></li>
            ))}
            {hasCV && <li><a class="link" href={href(siteConfig.files.cv)} download>Download CV<Icon name="download" /></a></li>}
          </ul>
        </div>
      )}

      {features.contactForm && (
        <div class="contact__block contact__block--form">
          <p class="label">Message</p>
          <form class="form" method="post" action={action || undefined} data-contact-form data-mailto={siteConfig.email}>
            <label><span class="label">Name</span><input name="name" autocomplete="name" required /></label>
            <label><span class="label">Email</span><input name="email" type="email" autocomplete="email" required /></label>
            <label><span class="label">Message</span><textarea name="message" required></textarea></label>
            <div><button class="btn btn--solid" type="submit">Send<Icon name="arrow_forward" /></button></div>
          </form>
        </div>
      )}
    </div>
  </div>
</section>
