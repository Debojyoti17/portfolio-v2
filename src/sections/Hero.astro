---
import { siteConfig } from '@site';
import { href } from '../lib/url';
import { hasCV } from '../lib/site';
import { getProjects } from '../lib/content';
import Field from '../components/Field.astro';
import Icon from '../components/Icon.astro';

const projects = await getProjects();
const words = siteConfig.name.split(' ');
---

<section class="hero" id="hero" aria-labelledby="hero-title">
  <Field scene="scene" mode="hero" class="hero__field" />
  <div class="container hero__inner">
    <h1 class="hero__name" id="hero-title">
      <span class="sr-only">{siteConfig.name}</span>
      <span aria-hidden="true">
        {words.map((w, i) => <span class="hero__line rise-in" style={`--i:${i}`}>{w}</span>)}
      </span>
    </h1>
    {siteConfig.status && <p class="hero__status rise-in" style="--i:3">{siteConfig.status}</p>}
    <p class="hero__actions rise-in" style="--i:4">
      {projects.length > 0 && <a class="link action" href="#research">Research &amp; projects<Icon name="arrow_downward" /></a>}
      <a class="link action" href="#contact">Contact<Icon name="arrow_downward" /></a>
      {hasCV && <a class="link action" href={href(siteConfig.files.cv)} download>CV<Icon name="download" /></a>}
    </p>
  </div>
</section>
