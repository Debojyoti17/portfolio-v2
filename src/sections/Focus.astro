---
import { siteConfig } from '@site';
import { href } from '../lib/url';
import { getProjects } from '../lib/content';
import SectionHead from '../components/SectionHead.astro';

const projects = await getProjects();
const areas = siteConfig.interests.map((i) => ({
  ...i,
  projects: projects.filter((p) => p.data.area === i.title),
}));
const pad = (n: number) => String(n).padStart(2, '0');
---

{areas.length > 0 && (
  <section class="sec" id="focus" aria-labelledby="focus-title" data-section data-numbered data-label="Research">
    <div class="container">
      <SectionHead label="Research" title="What I work on" id="focus-title" />
      <div class="areas">
        {areas.map((a, i) => (
          <article class="area" data-reveal="fade">
            <p class="area__idx dot" aria-hidden="true">{pad(i + 1)}</p>
            <h3 class="area__name">{a.title}</h3>
            <p class="area__note">{a.note}</p>
            {a.projects.length > 0 && (
              <ul class="area__projects" aria-label={`${a.title} projects`}>
                {a.projects.map((p) => (
                  <li><a class="link" href={href(`/work/${p.id}/`)}>{p.data.title}</a></li>
                ))}
              </ul>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>
)}
