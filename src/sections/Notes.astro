---
import { href } from '../lib/url';
import { getNotes } from '../lib/content';
import SectionHead from '../components/SectionHead.astro';
import NoteList from '../components/NoteList.astro';
import Icon from '../components/Icon.astro';
const notes = await getNotes();
---

{notes.length > 0 && (
  <section class="sec" id="notes" aria-labelledby="notes-title">
    <div class="container">
      <SectionHead label="Notes" title="Writing" id="notes-title" />
      <NoteList notes={notes.slice(0, 3)} />
      <div class="section-foot">
        <span></span>
        <a class="link action" href={href("/notes/")}>All notes<Icon name="arrow_forward" /></a>
      </div>
    </div>
  </section>
)}
