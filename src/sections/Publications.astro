---
import { getPublications } from '../lib/content';
import SectionHead from '../components/SectionHead.astro';
import PublicationList from '../components/PublicationList.astro';
const items = await getPublications();
---

{items.length > 0 && (
  <section class="sec" id="publications" aria-labelledby="pub-title">
    <div class="container">
      <SectionHead label="Publications" title="Papers" id="pub-title" />
      <PublicationList items={items} />
    </div>
  </section>
)}
