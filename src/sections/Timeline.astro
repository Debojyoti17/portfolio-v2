---
import { getTimeline } from '../lib/content';
import SectionHead from '../components/SectionHead.astro';
import TimelineList from '../components/TimelineList.astro';
const entries = await getTimeline();
---

{entries.length > 0 && (
  <section class="sec" id="timeline" aria-labelledby="timeline-title">
    <div class="container">
      <SectionHead label="Timeline" title="Path so far" id="timeline-title" />
      <TimelineList entries={entries} />
    </div>
  </section>
)}
